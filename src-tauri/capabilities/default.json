{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "airMD默认权限：窗口基础能力、关闭/销毁窗口、系统文件对话框",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:default",
    "dialog:default"
  ]
}